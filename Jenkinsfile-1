pipeline {
    agent { label 'aws_live_server' }

    environment {
        DEV_EMAIL = 'rishirajshinde1610@gmail.com'
    }

    tools {
        // Optional: if you want to ensure Maven is available
        // maven 'Maven 3.8.1'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    stages {
        stage('Scan') {
            steps {
                withSonarQubeEnv('sq1') {
                    sh './mvnw clean org.sonarsource.scanner.maven:sonar-maven-plugin:3.9.0.2155:sonar'
                }
            }
        }
    }

    post {
        always {
            emailext(
                subject: "Pipeline Status: ${currentBuild.result ?: 'SUCCESS'}",
                body: """<html>
                            <body>
                                <h3>Jenkins Pipeline Notification</h3>
                                <p>Status: <strong>${currentBuild.result ?: 'SUCCESS'}</strong></p>
                            </body>
                        </html>""",
                mimeType: 'text/html',
                to: "${DEV_EMAIL}",
                from: 'rishirajshinde1610@gmail.com'
            )
        }
    }
}
